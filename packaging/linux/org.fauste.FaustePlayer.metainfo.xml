<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.fauste.FaustePlayer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Fauste Player</name>
  <summary>Radio playout with several players and a cartwall</summary>
  <summary xml:lang="es">Emisión de radio con varios reproductores y una cartuchera</summary>
  <developer id="org.fauste">
    <name>Marc Sánchez Fauste</name>
  </developer>
  <description>
    <p>
      Fauste Player puts music, jingles and spots on air. Several independent
      players run side by side, each with its own playlists, and tracks mix
      sample-accurately at their MIX points.
    </p>
    <ul>
      <li>Automatic cue, MIX and outro markers from background analysis</li>
      <li>Pre-listen on a separate CUE output</li>
      <li>A cartwall of instant carts with pages, loops and exclusive carts</li>
      <li>Bit-perfect output on exclusive devices</li>
      <li>Keeps timing when an output device is lost, and recovers after a crash without putting anything on air</li>
    </ul>
  </description>
  <launchable type="desktop-id">org.fauste.FaustePlayer.desktop</launchable>
  <url type="homepage">https://sanchezfauste.com/fauste-player/</url>
  <url type="bugtracker">https://github.com/sanchezfauste/fauste-player/issues</url>
  <url type="help">https://sanchezfauste.com/fauste-player/guide/</url>
  <url type="vcs-browser">https://github.com/sanchezfauste/fauste-player</url>
  <url type="contribute">https://github.com/sanchezfauste/fauste-player/blob/master/CONTRIBUTING.md</url>
  <!-- The stores show these; docs/images is kept current by the screenshots workflow. -->
  <screenshots>
    <screenshot type="default">
      <caption>Four players, the playlists and the cartwall</caption>
      <image>https://raw.githubusercontent.com/sanchezfauste/fauste-player/master/docs/images/main-screen.png</image>
    </screenshot>
    <screenshot>
      <caption>Output devices, CUE and bit-perfect settings</caption>
      <image>https://raw.githubusercontent.com/sanchezfauste/fauste-player/master/docs/images/guide/settings-outputs.png</image>
    </screenshot>
    <screenshot>
      <caption>Loudness normalization settings</caption>
      <image>https://raw.githubusercontent.com/sanchezfauste/fauste-player/master/docs/images/guide/settings-loudness.png</image>
    </screenshot>
  </screenshots>
  <!-- The theme's accent (light scheme) and background (dark scheme). -->
  <branding>
    <color type="primary" scheme_preference="light">#9184d9</color>
    <color type="primary" scheme_preference="dark">#161826</color>
  </branding>
  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
  </recommends>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
  </categories>
  <provides>
    <binary>fauste-player</binary>
    <mediatype>audio/x-mpegurl</mediatype>
    <mediatype>audio/x-scpls</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <!-- <releases> is added by scripts/package/metainfo.sh with the version being packaged. -->
</component>
